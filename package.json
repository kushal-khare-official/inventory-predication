{
  "name": "inventory-reorder-planner",
  "version": "1.0.0",
  "description": "Stockout-risk detection and budget-constrained weekly reorder planning from an inventory event log",
  "private": true,
  "main": "main.ts",
  "scripts": {
    "start": "tsx main.ts data/inventory_events.json",
    "serve": "tsx src/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
